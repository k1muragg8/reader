<idea-plugin>
    <id>com.shaoYe.reader</id>
    <name>Reader Master</name>
    <vendor>haj1megg8</vendor>
    <idea-version since-build="231" />

    <description><![CDATA[
  <h3>English Description</h3>
  <p>A high-performance EPUB reader integrated into your IDE. Perfect for reading technical documentation while coding.</p>
  <ul>
    <li><b>Controls</b>: Use Arrow keys or A/D keys for page navigation.</li>
    <li><b>UI</b>: Zero-margin layout for maximum readability.</li>
    <li><b>Author</b>: haj1megg8</li>
  </ul>
  <hr/>
  <h3>简体中文说明</h3>
  <p>集成于 IDE 内部的高性能 EPUB 阅读器。让您在编写代码的同时无缝阅读技术书籍。</p>
  <ul>
    <li><b>操作说明</b>：使用键盘左右方向键或 A/D 键进行翻页。</li>
    <li><b>界面优化</b>：彻底去除侧边阴影，文字全屏显示。</li>
    <li><b>署名</b>：haj1megg8</li>
  </ul>
    ]]></description>

    <change-notes><![CDATA[
    <ul>
        <li>Fixed image rendering issues on Linux/JCEF using Base64 injection.</li>
        <li>Optimized performance with background thread parsing.</li>
        <li>Improved UI by removing excessive margins.</li>
        <li>Added progress persistence.</li>
    </ul>
    ]]></change-notes>
    <depends>com.intellij.modules.platform</depends>

    <extensions defaultExtensionNs="com.intellij">
        <toolWindow id="ReaderMaster" secondary="true" icon="AllIcons.Actions.Preview" anchor="right"
                    factoryClass="com.shaoYe.reader.EpubToolWindowFactory"/>
        <projectService serviceImplementation="com.shaoYe.reader.ReaderService"/>
    </extensions>

    <actions>
        <action id="ShaoYe.NextPage" class="com.shaoYe.reader.NextPageAction" text="下一页 (Next Page)" description="翻到下一页">
            <keyboard-shortcut keymap="$default" first-keystroke="RIGHT"/>
        </action>
        <action id="ShaoYe.PrevPage" class="com.shaoYe.reader.PrevPageAction" text="上一页 (Prev Page)" description="翻到上一页">
            <keyboard-shortcut keymap="$default" first-keystroke="LEFT"/>
        </action>
        <action id="ShaoYe.ZoomIn" class="com.shaoYe.reader.ZoomInAction" text="放大字体 (Zoom In)" description="放大字体">
            <keyboard-shortcut keymap="$default" first-keystroke="alt EQUALS"/>
        </action>
        <action id="ShaoYe.ZoomOut" class="com.shaoYe.reader.ZoomOutAction" text="缩小字体 (Zoom Out)" description="缩小字体">
            <keyboard-shortcut keymap="$default" first-keystroke="alt MINUS"/>
        </action>

    </actions>
</idea-plugin>